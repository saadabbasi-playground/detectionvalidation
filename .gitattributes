# Ensure consistent line endings across platforms
* text=auto

# Force LF for all shell scripts (they run on Linux containers)
*.sh text eol=lf
dv text eol=lf
Vagrantfile text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binaries — no line ending conversion
*.exe binary
*.dll binary
*.so binary
*.png binary
*.jpg binary
*.svg binary
