# standard.env — developer workstation (4 GB RAM)

DV_CORE_MEMORY=512m
DV_ATTACKER_MEMORY=512m
DV_VICTIM_MEMORY=512m
DV_RUNNER_MEMORY=256m
DV_WIN_VICTIM_MEMORY=2g

OPENSEARCH_HEAP=1g
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
OPENSEARCH_DISCOVERY=single-node
DV_ENABLE_SPLUNK=true
DV_OPENSEARCH_SINGLE_NODE=true

SPLUNK_MEMORY=2g
ES_JAVA_OPTS=-Xms512m -Xmx512m
GRAFANA_MEMORY=256m
VECTOR_MEMORY=128m

DV_LOG_LEVEL=INFO
