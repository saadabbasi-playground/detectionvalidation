# full.env — server / full lab with all services (8 GB+ RAM)

DV_CORE_MEMORY=1g
DV_ATTACKER_MEMORY=1g
DV_VICTIM_MEMORY=1g
DV_RUNNER_MEMORY=512m
DV_WIN_VICTIM_MEMORY=4g

OPENSEARCH_HEAP=2g
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
OPENSEARCH_DISCOVERY=cluster
DV_ENABLE_SPLUNK=true
DV_OPENSEARCH_SINGLE_NODE=false

SPLUNK_MEMORY=4g
ES_JAVA_OPTS=-Xms1g -Xmx1g
GRAFANA_MEMORY=512m
VECTOR_MEMORY=256m

DV_LOG_LEVEL=INFO
