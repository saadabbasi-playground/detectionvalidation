# tiny.env — free tier / Pi / CI (≤1 GB RAM)
# OpenSearch single-node only; Splunk disabled.

DV_CORE_MEMORY=256m
DV_ATTACKER_MEMORY=256m
DV_VICTIM_MEMORY=256m
DV_RUNNER_MEMORY=128m
DV_WIN_VICTIM_MEMORY=1g

OPENSEARCH_HEAP=1536m
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
OPENSEARCH_DISCOVERY=single-node
DV_ENABLE_SPLUNK=false
DV_OPENSEARCH_SINGLE_NODE=true

ES_JAVA_OPTS=-Xms256m -Xmx256m
DASHBOARDS_MEMORY=512m
GRAFANA_MEMORY=128m
VECTOR_MEMORY=64m

DV_LOG_LEVEL=WARNING
DV_ENABLE_DASHBOARDS=false
