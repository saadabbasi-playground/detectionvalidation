#!/usr/bin/env bash
# detection-validator (dv) — unified launcher wrapping docker compose.
set -euo pipefail

VERSION="0.1.0"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_DIR="${SCRIPT_DIR}/compose"
PROFILES_DIR="${COMPOSE_DIR}/profiles"

# ─── colours ────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
CYAN='\033[0;36m'; BOLD='\033[1m'; RESET='\033[0m'

info()  { echo -e "${CYAN}[dv]${RESET} $*"; }
ok()    { echo -e "${GREEN}[dv]${RESET} $*"; }
warn()  { echo -e "${YELLOW}[WARN]${RESET} $*"; }
error() { echo -e "${RED}[ERROR]${RESET} $*" >&2; }
die()   { error "$@"; exit 1; }

# ─── arch detection ─────────────────────────────────────────────────────────
detect_arch() {
    local machine; machine="$(uname -m)"
    case "$machine" in
        x86_64|amd64)  echo "amd64" ;;
        aarch64|arm64) echo "arm64" ;;
        armv7l)        echo "arm32" ;;
        *)             echo "unknown" ;;
    esac
}

detect_docker_arch() {
    # Guard: skip if daemon unreachable (avoids hang on macOS when Docker Desktop is closed)
    docker info --format '{{.Architecture}}' 2>/dev/null & local pid=$!
    sleep 2 && kill "$pid" 2>/dev/null & wait "$pid" 2>/dev/null | \
        sed 's/x86_64/amd64/;s/aarch64/arm64/'
}

docker_daemon_up() {
    # Quick non-blocking check: use cached docker version output rather than docker info
    docker version --format '{{.Server.Version}}' &>/dev/null 2>&1
}

is_arm() {
    local arch; arch="$(detect_arch)"
    [[ "$arch" == "arm64" || "$arch" == "arm32" ]]
}

detect_windows_container_support() {
    # True only on Windows hosts / Docker Desktop with Windows containers mode.
    # Only call docker info if we know daemon is up (avoids blocking hang).
    docker_daemon_up || return 1
    docker info --format '{{.OSType}}' 2>/dev/null | grep -qi "windows"
}

get_available_ram_gb() {
    # Returns integer GB
    if command -v free &>/dev/null; then
        free -g | awk '/^Mem:/{print $2}'
    elif [[ "$(uname)" == "Darwin" ]]; then
        sysctl -n hw.memsize 2>/dev/null | awk '{printf "%d", $1/1024/1024/1024}'
    else
        echo "?"
    fi
}

docker_version_ok() {
    local ver; ver="$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 0)"
    local major; major="$(echo "$ver" | cut -d. -f1)"
    [[ "$major" -ge 24 ]] 2>/dev/null
}

# ─── SIEM helpers ───────────────────────────────────────────────────────────
VALID_SIEMS=(splunk splunk-uf opensearch elastic sentinel chronicle wazuh null)

validate_siem() {
    local siem="$1"
    for valid in "${VALID_SIEMS[@]}"; do
        [[ "$siem" == "$valid" ]] && return 0
    done
    die "Unknown SIEM: '${siem}'. Valid: ${VALID_SIEMS[*]}"
}

# Expand comma-separated --siem list into compose -f flags
siem_compose_flags() {
    local siem_arg="$1"
    local flags=()
    IFS=',' read -ra siems <<< "$siem_arg"
    for siem in "${siems[@]}"; do
        validate_siem "$siem"
        [[ "$siem" == "null" ]] && continue
        # splunk-uf reuses splunk.yml with a different profile
        local yml_name="${siem/splunk-uf/splunk}"
        local siem_file="${COMPOSE_DIR}/siem/${yml_name}.yml"
        [[ -f "$siem_file" ]] || die "SIEM compose file not found: ${siem_file}"
        flags+=("-f" "$siem_file")
    done
    echo "${flags[@]:-}"
}

siem_arm_compat_check() {
    local siem_arg="$1"
    IFS=',' read -ra siems <<< "$siem_arg"
    for siem in "${siems[@]}"; do
        case "$siem" in
            splunk|splunk-uf)
                if is_arm; then
                    warn "Splunk official images do not support ARM64 natively." >&2
                    warn "Alternatives: --siem opensearch  or  --siem wazuh" >&2
                fi
                ;;
        esac
    done
}

# ─── profile helpers ────────────────────────────────────────────────────────
resolve_profile_file() {
    local profile="${1:-standard}"
    local env_file="${PROFILES_DIR}/${profile}.env"
    [[ -f "$env_file" ]] || die "Profile '${profile}' not found. Available: tiny standard full"
    echo "$env_file"
}

# ─── build compose command ──────────────────────────────────────────────────
build_compose_cmd() {
    local stack="$1"       # core | lab | siem
    local siem="${2:-null}"
    local windows="${3:-auto}"
    local profile="${4:-standard}"

    local arch; arch="$(detect_arch)"
    local profile_file; profile_file="$(resolve_profile_file "$profile")"

    local compose_files=("-f" "${COMPOSE_DIR}/docker-compose.yml")

    case "$stack" in
        core)
            : # base only
            ;;
        lab)
            compose_files+=("-f" "${COMPOSE_DIR}/docker-compose.lab.yml")
            # Windows mode
            local win_mode="$windows"
            if [[ "$win_mode" == "auto" ]]; then
                if detect_windows_container_support; then
                    win_mode="container"
                elif is_arm; then
                    win_mode="emulator"
                else
                    win_mode="emulator"
                fi
            fi
            case "$win_mode" in
                container)
                    if is_arm; then
                        warn "Windows containers require amd64. Falling back to win-emulator on ARM." >&2
                        win_mode="emulator"
                    else
                        compose_files+=("-f" "${COMPOSE_DIR}/docker-compose.windows.yml")
                        ok "Windows containers enabled (amd64)." >&2
                    fi
                    ;;
                emulator)
                    if is_arm; then
                        echo -e "${YELLOW}┌─────────────────────────────────────────────────────────────────┐${RESET}" >&2
                        echo -e "${YELLOW}│  ARM64 detected — using win-emulator instead of win-victim      │${RESET}" >&2
                        echo -e "${YELLOW}│  Windows Sysmon events will be synthesised from a script lib.   │${RESET}" >&2
                        echo -e "${YELLOW}│  Trade-off: emulated events lack live kernel telemetry.         │${RESET}" >&2
                        echo -e "${YELLOW}│  Override: ./dv up lab --windows external (point to real host)  │${RESET}" >&2
                        echo -e "${YELLOW}└─────────────────────────────────────────────────────────────────┘${RESET}" >&2
                    fi
                    ;;
                external)
                    compose_files+=("-f" "${COMPOSE_DIR}/docker-compose.external.yml")
                    ;;
                none)
                    : # no windows service
                    ;;
            esac
            ;;
        *)
            die "Unknown stack: '${stack}'. Use: core | lab"
            ;;
    esac

    # Attach SIEM compose files
    if [[ "$siem" != "null" ]]; then
        siem_arm_compat_check "$siem"
        local siem_flags
        siem_flags="$(siem_compose_flags "$siem")" || exit 1
        if [[ -n "$siem_flags" ]]; then
            # shellcheck disable=SC2206
            compose_files+=($siem_flags)
            # Add vector shipper when we have a SIEM
            local shipper_file="${COMPOSE_DIR}/shippers/vector.yml"
            [[ -f "$shipper_file" ]] && compose_files+=("-f" "$shipper_file")
        fi
    fi

    # Gate opensearch-dashboards on DV_ENABLE_DASHBOARDS (default: true; tiny.env sets false)
    local enable_dashboards="true"
    local _dbval
    _dbval="$(grep -E '^DV_ENABLE_DASHBOARDS=' "$profile_file" 2>/dev/null | head -1 | cut -d= -f2)"
    [[ -n "$_dbval" ]] && enable_dashboards="$_dbval"
    local dashboards_flag=""
    [[ "$enable_dashboards" != "false" ]] && dashboards_flag="--profile dashboards"

    # Emit the full compose command (no trailing args — callers append up/down/etc.)
    echo "docker compose --project-directory ${SCRIPT_DIR} \
--env-file ${profile_file} \
${dashboards_flag} \
${compose_files[*]}"
}

# ─── subcommands ────────────────────────────────────────────────────────────

cmd_up() {
    local stack="core"
    local siem="null"
    local windows="auto"
    local profile="standard"
    local detach="-d"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            core|lab)         stack="$1" ;;
            --siem)           siem="$2"; shift ;;
            --siem=*)         siem="${1#--siem=}" ;;
            --windows)        windows="$2"; shift ;;
            --windows=*)      windows="${1#--windows=}" ;;
            --profile)        profile="$2"; shift ;;
            --profile=*)      profile="${1#--profile=}" ;;
            --no-detach)      detach="" ;;
            *) die "Unknown argument: $1" ;;
        esac
        shift
    done

    local compose_cmd
    compose_cmd="$(build_compose_cmd "$stack" "$siem" "$windows" "$profile")"
    info "Starting stack: ${BOLD}${stack}${RESET}  siem=${siem}  profile=${profile}"
    local native_platform="linux/$(detect_arch)"
    export BUILDPLATFORM="${BUILDPLATFORM:-$native_platform}"
    export TARGETPLATFORM="${TARGETPLATFORM:-$native_platform}"
    eval "$compose_cmd up --build ${detach}"
    ok "Stack '${stack}' is running. Use './dv status' to check."
}

cmd_down() {
    local stack="core"
    local siem="null"
    local windows="auto"
    local profile="standard"
    local volumes=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            core|lab)     stack="$1" ;;
            --siem)       siem="$2"; shift ;;
            --siem=*)     siem="${1#--siem=}" ;;
            --volumes|-v) volumes=true ;;
            --profile)    profile="$2"; shift ;;
            --profile=*)  profile="${1#--profile=}" ;;
            *) die "Unknown argument: $1" ;;
        esac
        shift
    done

    local compose_cmd
    compose_cmd="$(build_compose_cmd "$stack" "$siem" "$windows" "$profile")"
    local extra; extra="$(${volumes} && echo '--volumes' || echo '')"
    eval "$compose_cmd down $extra"
    ok "Stack stopped."
}

cmd_status() {
    local profile="${1:-standard}"
    local profile_file; profile_file="$(resolve_profile_file "$profile")"
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        --env-file "${profile_file}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        ps --format table
}

cmd_logs() {
    local service="${1:-}"
    local follow=false
    local tail=100

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -f|--follow) follow=true ;;
            --tail)      tail="$2"; shift ;;
            *)           service="$1" ;;
        esac
        shift
    done

    local profile_file; profile_file="$(resolve_profile_file "standard")"
    local flags="--tail ${tail}"
    ${follow} && flags="${flags} -f"
    # shellcheck disable=SC2086
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        --env-file "${profile_file}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        logs ${flags} ${service:-}
}

cmd_exec() {
    local service="${1:-core}"
    shift || true
    local cmd="${*:-bash}"
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec "$service" $cmd
}

cmd_build() {
    local target="${1:-default}"
    shift || true
    info "Building with docker buildx bake (target: ${target})"
    docker buildx bake --file "${SCRIPT_DIR}/docker-bake.hcl" "$target" "$@"
}

cmd_siem() {
    local subcmd="${1:-help}"
    shift || true
    case "$subcmd" in
        list)
            echo "Available SIEMs: ${VALID_SIEMS[*]}"
            ;;
        status)
            docker compose \
                --project-directory "${SCRIPT_DIR}" \
                -f "${COMPOSE_DIR}/docker-compose.yml" \
                ps --format table | grep -iE "splunk|opensearch|elastic|wazuh|kibana" || \
                echo "No SIEM containers running."
            ;;
        *)
            echo "Usage: ./dv siem <list|status>"
            ;;
    esac
}

cmd_deploy() {
    info "Deploying detection rules..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator deploy "$@"
}

cmd_validate() {
    info "Running detection validation..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator validate "$@"
}

cmd_report() {
    info "Generating report..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator report "$@"
}

cmd_migrate() {
    info "Running SIEM migration..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator migrate "$@"
}

cmd_scenarios() {
    local subcmd="${1:-list}"
    shift || true
    case "$subcmd" in
        list)
            find "${SCRIPT_DIR}/scenarios" -name "*.yml" -o -name "*.yaml" 2>/dev/null | \
                sort | sed "s|${SCRIPT_DIR}/||"
            ;;
        run)
            docker compose \
                --project-directory "${SCRIPT_DIR}" \
                -f "${COMPOSE_DIR}/docker-compose.yml" \
                exec core detection-validator scenarios run "$@"
            ;;
        *)
            echo "Usage: ./dv scenarios <list|run [scenario]>"
            ;;
    esac
}

cmd_agent() {
    local subcmd="${1:-status}"
    shift || true
    case "$subcmd" in
        status)
            docker compose \
                --project-directory "${SCRIPT_DIR}" \
                -f "${COMPOSE_DIR}/docker-compose.yml" \
                exec core detection-validator agent status
            ;;
        connect)
            docker compose \
                --project-directory "${SCRIPT_DIR}" \
                -f "${COMPOSE_DIR}/docker-compose.yml" \
                exec core detection-validator agent connect "$@"
            ;;
        *)
            echo "Usage: ./dv agent <status|connect>"
            ;;
    esac
}

cmd_badge() {
    info "Generating ATT&CK coverage badge..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator badge "$@"
}

cmd_watch() {
    info "Watching for detection changes..."
    docker compose \
        --project-directory "${SCRIPT_DIR}" \
        -f "${COMPOSE_DIR}/docker-compose.yml" \
        exec core detection-validator watch "$@"
}

# ─── doctor ─────────────────────────────────────────────────────────────────
cmd_doctor() {
    local siem="${1:-null}"
    local profile="${2:-standard}"

    echo -e "${BOLD}detection-validator doctor v${VERSION}${RESET}"
    echo "────────────────────────────────────────"

    local all_ok=true
    local warn_count=0

    # Helper to print check result
    check() {
        local label="$1"; local status="$2"; local detail="${3:-}"
        if [[ "$status" == "ok" ]]; then
            echo -e "  ${GREEN}✓${RESET}  ${label}  ${detail:+${detail}}"
        elif [[ "$status" == "warn" ]]; then
            echo -e "  ${YELLOW}⚠${RESET}  ${label}  ${YELLOW}${detail}${RESET}"
            ((warn_count++)) || true
        else
            echo -e "  ${RED}✗${RESET}  ${label}  ${RED}${detail}${RESET}"
            all_ok=false
        fi
    }

    # 1. Docker present
    if command -v docker &>/dev/null; then
        local dver; dver="$(docker version --format '{{.Server.Version}}' 2>/dev/null || echo 'n/a')"
        check "Docker" "ok" "v${dver}"
    else
        check "Docker" "fail" "docker not found in PATH"
    fi

    # 2. Docker daemon reachable
    if docker info &>/dev/null 2>&1; then
        check "Docker daemon" "ok" "reachable"
    else
        check "Docker daemon" "fail" "not running — start Docker Desktop or Docker Engine"
    fi

    # 3. Docker version ≥ 24
    if docker_version_ok; then
        check "Docker version ≥ 24" "ok"
    else
        check "Docker version ≥ 24" "warn" "some features may not work — upgrade Docker"
    fi

    # 4. BuildKit / buildx
    if docker buildx version &>/dev/null 2>&1; then
        local bxver; bxver="$(docker buildx version 2>/dev/null | head -1)"
        check "docker buildx" "ok" "$bxver"
    else
        check "docker buildx" "fail" "not available — install Docker Buildx plugin"
    fi

    # 5. docker compose v2
    if docker compose version &>/dev/null 2>&1; then
        local cv; cv="$(docker compose version --short 2>/dev/null || echo 'n/a')"
        check "docker compose v2" "ok" "v${cv}"
    else
        check "docker compose v2" "fail" "docker compose plugin not found"
    fi

    # 6. Host architecture
    local arch; arch="$(detect_arch)"
    check "Host architecture" "ok" "${arch}"

    # 7. Available RAM
    local ram; ram="$(get_available_ram_gb)"
    if [[ "$ram" == "?" ]]; then
        check "Available RAM" "warn" "unable to detect"
    elif [[ "$ram" -ge 8 ]]; then
        check "Available RAM" "ok" "${ram} GB — full profile supported"
    elif [[ "$ram" -ge 4 ]]; then
        check "Available RAM" "ok" "${ram} GB — standard profile supported"
    elif [[ "$ram" -ge 2 ]]; then
        check "Available RAM" "warn" "${ram} GB — use --profile tiny (some SIEMs disabled)"
    else
        check "Available RAM" "warn" "${ram} GB — very limited; use --profile tiny"
    fi

    # 8. Windows container support
    if detect_windows_container_support 2>/dev/null; then
        check "Windows containers" "ok" "Windows daemon detected"
    elif is_arm; then
        check "Windows containers" "warn" "ARM host — win-emulator will be used automatically"
    else
        check "Windows containers" "warn" "not available — win-emulator will be used instead"
    fi

    # 9. Multi-arch builder
    if docker buildx ls 2>/dev/null | grep -q "linux/arm64"; then
        check "Multi-arch builder (arm64)" "ok"
    else
        check "Multi-arch builder (arm64)" "warn" \
            "run: docker buildx create --use --name multiarch --driver docker-container"
    fi

    # 10. uv (Python package manager)
    if command -v uv &>/dev/null; then
        local uvver; uvver="$(uv --version 2>/dev/null || echo 'n/a')"
        check "uv" "ok" "$uvver"
    else
        check "uv" "warn" "not installed — run: curl -LsSf https://astral.sh/uv/install.sh | sh"
    fi

    # 11. SIEM compatibility check
    if [[ "$siem" != "null" && -n "$siem" ]]; then
        IFS=',' read -ra siems <<< "$siem"
        for s in "${siems[@]}"; do
            case "$s" in
                splunk|splunk-uf)
                    if is_arm; then
                        check "SIEM: ${s}" "warn" \
                            "Splunk has no official ARM64 image — use opensearch or wazuh instead"
                    else
                        check "SIEM: ${s}" "ok"
                    fi
                    ;;
                null) ;;
                *)    check "SIEM: ${s}" "ok" ;;
            esac
        done
    fi

    # 12. Compose files present
    local required_files=(
        "${COMPOSE_DIR}/docker-compose.yml"
        "${COMPOSE_DIR}/docker-compose.lab.yml"
        "${COMPOSE_DIR}/docker-compose.siem.yml"
    )
    for f in "${required_files[@]}"; do
        if [[ -f "$f" ]]; then
            check "Compose file: $(basename "$f")" "ok"
        else
            check "Compose file: $(basename "$f")" "fail" "missing: $f"
        fi
    done

    echo "────────────────────────────────────────"
    if $all_ok && [[ $warn_count -eq 0 ]]; then
        ok "All checks passed. Run './dv up core' to start."
    elif $all_ok; then
        warn "${warn_count} warning(s). Review above. Run './dv up core' to start."
        exit 0
    else
        die "One or more checks failed. Fix the issues above before proceeding."
    fi
}

# ─── usage ───────────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
${BOLD}detection-validator (dv) v${VERSION}${RESET}

USAGE
  ./dv <command> [options]

COMMANDS
  up [core|lab]            Start a stack (default: core)
  down [core|lab]          Stop a stack
  status                   Show running services
  logs [service] [-f]      Tail logs
  exec <service> [cmd]     Exec into a container (default: bash)
  build [target]           Build images with docker buildx bake
  doctor                   Check host prerequisites and config
  siem <list|status>       Manage SIEM backends
  deploy                   Deploy detection rules to SIEM
  validate                 Run detection validation suite
  report                   Generate validation report
  migrate                  Run SIEM migration
  scenarios <list|run>     Manage attack scenarios
  agent <status|connect>   Manage remote agents
  badge                    Generate ATT&CK coverage badge
  watch                    Watch detection repo for changes

OPTIONS (up/down)
  --siem <name[,name]>     SIEM(s): splunk splunk-uf opensearch elastic
                           sentinel chronicle wazuh null (default: null)
  --windows <mode>         container|emulator|external|none (default: auto)
  --profile <name>         Resource profile: tiny standard full (default: standard)

EXAMPLES
  ./dv up core
  ./dv up lab --siem opensearch --profile tiny
  ./dv up lab --siem splunk,opensearch --windows container
  ./dv doctor --siem opensearch
  ./dv validate --rules ./detections/
  ./dv report --format sarif --output results.sarif

EOF
    exit 0
}

# ─── main ────────────────────────────────────────────────────────────────────
main() {
    if [[ $# -eq 0 ]]; then usage; fi

    local cmd="$1"; shift

    case "$cmd" in
        up)        cmd_up "$@" ;;
        down)      cmd_down "$@" ;;
        status)    cmd_status "$@" ;;
        logs)      cmd_logs "$@" ;;
        exec)      cmd_exec "$@" ;;
        build)     cmd_build "$@" ;;
        doctor)    cmd_doctor "$@" ;;
        siem)      cmd_siem "$@" ;;
        deploy)    cmd_deploy "$@" ;;
        validate)  cmd_validate "$@" ;;
        report)    cmd_report "$@" ;;
        migrate)   cmd_migrate "$@" ;;
        scenarios) cmd_scenarios "$@" ;;
        agent)     cmd_agent "$@" ;;
        badge)     cmd_badge "$@" ;;
        watch)     cmd_watch "$@" ;;
        --version|-v) echo "dv v${VERSION}" ;;
        --help|-h|help) usage ;;
        *) die "Unknown command: '${cmd}'. Run './dv --help' for usage." ;;
    esac
}

main "$@"
